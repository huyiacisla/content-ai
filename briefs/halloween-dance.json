{
  "meta": {
    "title": "Halloween Dance — Hề Chuột 3 Đầu",
    "lang": "vi",
    "engine": "hyperframes + three.js",
    "project": "hyperframes-app/halloween3d",
    "format": {
      "durationSec": 16,
      "aspect": "9:16",
      "width": 1080,
      "height": 1920,
      "fps": 30,
      "totalFrames": 480
    },
    "beat": {
      "bpm": 120,
      "beatSec": 0.5,
      "beatsPerBar": 4,
      "bars": 8,
      "rule": "mọi động tác chốt trên nhịp; đổi động tác mỗi 2 ô nhịp (4s)"
    },
    "music": {
      "src": "assets/music-120bpm.mp3",
      "volume": 0.5
    }
  },
  "character": {
    "id": "jester",
    "name": "Hề Chuột 3 Đầu",
    "reference": "jester3d/reference.jpg",
    "look": "3 đầu (vương miện / nón phù thủy nháy mắt lè lưỡi / mũ cao chán đời), 6 tay, cổ xếp nếp, quần hề kim cương, giày mũi cong, 2 đuôi có bùa",
    "rig": {
      "body": "pivot hông (627,1000) — lắc hông; mang đầu, tay, đuôi",
      "heads": "pivot cổ — nghiêng canon",
      "arms": "pivot vai — 3 tầng mỗi bên",
      "legs": "pivot hông — nhấc xen kẽ",
      "tails": "pivot gốc đuôi — quẫy",
      "pixelToWorld": {
        "x": "(px - 627) / 300",
        "y": "(1130 - py) / 300"
      }
    },
    "method": {
      "kind": "puppet-2.5d",
      "tool": "hyperframes-app/halloween3d/tools/cut_parts.py",
      "note": "cắt nhân vật từ chính tranh thành tấm alpha có khớp (3 đầu kèm mũ/tai, thân+quần, 6 tay kèm bàn tay/đạo cụ, 2 chân+giày, 2 đuôi+bùa, ngôi sao); xếp lớp theo z cho thị sai; viền co 1px + làm mịn, render alphaToCoverage",
      "parts": "assets/parts.json"
    }
  },
  "style": {
    "palette": {
      "night": "#1a1030",
      "nightTop": "#2b1650",
      "moon": "#f4e9c8",
