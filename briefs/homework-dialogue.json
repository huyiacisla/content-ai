{
  "meta": {
    "title": "Hai bạn bàn bài tập nộp sáng mai",
    "lang": "vi",
    "role": "senior motion designer",
    "engine": "hyperframes",
    "format": {
      "durationSec": 30,
      "aspect": "9:16",
      "width": 1080,
      "height": 1920,
      "fps": 30,
      "totalFrames": 900
    },
    "beat": {
      "bpm": 120,
      "beatSec": 0.5,
      "framesPerBeat": 15,
      "rule": "cắt cảnh/thoại trên nhịp; bắt đầu mỗi 4 nhịp (2s)"
    },
    "interactionsNote": "Nhân vật = ảnh tĩnh ⇒ hoạt cảnh dựng bằng transform (tịnh tiến/nghiêng/nhún theo nhịp) + props (tim, nối tay, đường, skyline)"
  },
