{
  "meta": {
    "title": "Hai bạn bàn bài tập nộp sáng mai",
    "lang": "vi",
    "role": "senior motion designer",
    "engine": "hyperframes",
    "format": {
      "durationSec": 30,
      "aspect": "9:16",
      "width": 1080,
      "height": 1920,
      "fps": 30,
      "totalFrames": 900
    },
    "beat": {
      "bpm": 120,
      "beatSec": 0.5,
