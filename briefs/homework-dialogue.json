      "bg": "#FFFFFF",
      "ink": "#1B2A41",
      "babybeat": "#7EC8F0",
      "accent": "#FF7A45"
    },
    "accentRule": "1 điểm nhấn: #FF7A45 chỉ cho 1 yếu tố nổi bật mỗi cảnh",
    "type": {
      "family": "Quicksand",
      "weight": 700,
      "maxWordsPerText": 6
    },
    "motion": {
      "easing": "damped-spring",
      "spring": {
        "stiffness": 180,
        "damping": 18,
        "mass": 1
      },
      "cut": "on-beat"
    },
    "doNot": [
      "fade mặc định",
      "glow"
    ]
  },
